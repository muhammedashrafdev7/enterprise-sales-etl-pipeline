                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    c.CustomerID,
    ISNULL(CAST(c.PersonID AS VARCHAR), 'Store Customer') AS FullName,
    ISNULL(CAST(c.StoreID AS VARCHAR), 'Individual') AS EmailAddress,
    t.Name AS Territory
FROM SLS_Customers c
LEFT JOIN SLS_Territories t 
    ON c.TerritoryID = t.TerritoryID</property>
